 // must never override a later cancellation or a move back to pending.
 const confirmed=b=>['booked','confirmed'].includes(String(b.status||'').toLowerCase());
 const label=b=>b.type==='Accommodation'?'Accom':b.type;
 const dest=b=>b.type==='Accommodation'?(b.details?.hotel||b.name||b.details?.place||''):(b.details?.destination||b.details?.place||b.name||'');
 const add=(date,type,name,status,source='booking',time='')=>items.push({date,type,name,status,source,time});
 const stays=[];
 for(const b of data.customBookings||[]){
  if(!b.date||!['Train','Bus','Flight','Taxi','Accommodation'].includes(b.type))continue;
  const currentStatus=String(b.status||'').toLowerCase();
  const status=b.reservationMode==='unreserved'?'Unreserved':currentStatus==='cancelled'?'Not booked':confirmed(b)?'Booked':'Pending';
  if(b.type==='Accommodation'){
   if(status==='Booked')stays.push(b);
   const end=b.checkoutDate&&b.checkoutDate>b.date?b.checkoutDate:plusDay(b.date);
   for(let date=b.date,n=0;date<end&&n<180;date=plusDay(date),n++)add(date,'Accom',dest(b),status,'booking',n===0?(b.time||b.details?.checkinTime||''):'');
  }else add(b.date,label(b),dest(b),status,'booking',b.details?.departureTime||b.time||'');
 }
 // Any confirmed accommodation stay covers every night from check-in (inclusive)
 // through check-out (exclusive). The booking is authoritative, regardless of
 // differences between reminder text and hotel/property name.
 const covered=date=>stays.some(b=>b.date<=date&&date<(b.checkoutDate&&b.checkoutDate>b.date?b.checkoutDate:plusDay(b.date)));

 for(let i=0;i<initialBookings.length;i++){
  const entry=initialBookings[i],m=String(entry[0]||'').match(/(\d{1,2})\s+([A-Za-z]{3})/);
  const month=m?['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'].indexOf(m[2].toLowerCase())+1:0;
  if(!month)continue;
  const date=(data.tripStart||String(new Date().getFullYear())).slice(0,4)+'-'+String(month).padStart(2,'0')+'-'+m[1].padStart(2,'0');
  const description=String(entry[1]||'');
  const type=/hotel|stay|room|accommodat/i.test(description)?'Accom':/train/i.test(description)?'Train':/flight/i.test(description)?'Flight':/bus/i.test(description)?'Bus':null;
  if(!type)continue;
  if(type==='Accom'&&covered(date))continue;
  // An existing structured booking supersedes a reminder for that date/type.
  if(items.some(x=>x.date===date&&x.type===type&&x.source==='booking'))continue;
  add(date,type,description,data.bookings[i]==='booked'?'Booked':'Pending','reminder');
 }
 // Remove stale pending accommodation rows for nights covered by a confirmed stay,
 // including older manually entered booking placeholders.
 const cleanItems=items.filter(x=>!(x.type==='Accom'&&x.status==='Pending'&&covered(x.date)));
 // Consolidate one summary per date/type/destination; booked wins over pending.
 const merged=new Map();
 for(const item of cleanItems){
  const key=item.date+'|'+item.type+'|'+clean(item.name);
  const prev=merged.get(key);
  if(!prev||item.status==='Booked'&&prev.status!=='Booked')merged.set(key,item);
 }
 // Sort by actual event time, not by booking type. Untimed reminders follow timed entries.
 const minuteOf=t=>{const v=String(t||'').trim();if(!v)return 9999;const m=v.match(/^(\d{1,2}):(\d{2})(?:\s*(am|pm))?$/i);if(!m)return 9999;let h=Number(m[1]),min=Number(m[2]);if(min>59||h>23)return 9999;if(m[3]){if(h<1||h>12)return 9999;h=(h%12)+(m[3].toLowerCase()==='pm'?12:0);}return h*60+min;};
 const rows=[...merged.values()].sort((a,b)=>a.date.localeCompare(b.date)||minuteOf(a.time)-minuteOf(b.time)||a.type.localeCompare(b.type)||a.name.localeCompare(b.name));
 const prettyDate=date=>{const p=date.split('-');return p[2]+'.'+p[1]+'.'+p[0].slice(2)};
 el('homeBookingOverview').innerHTML=rows.length?rows.map(x=>'<div class="expense booking-summary-row"><div class="booking-summary-details"><div><span class="booking-summary-date">'+escapeHTML(prettyDate(x.date))+'</span><span class="booking-summary-mode"> · '+escapeHTML(x.type)+'</span></div><div class="booking-summary-description">'+escapeHTML(x.type==='Accom'?(x.name||'Accommodation'):(x.name?'to '+x.name:'Destination not entered'))+'</div></div><span class="pill booking-summary-status" style="'+(x.status==='Booked'?'background:#d9f7e4;color:#13633d':x.status==='Unreserved'?'background:#dbeafe;color:#174ea6':'background:#fee2e2;color:#b42318')+'">'+escapeHTML(x.status)+'</span></div>').join(''):'<p class="tiny">No booking requirements recorded yet.</p>';
}
