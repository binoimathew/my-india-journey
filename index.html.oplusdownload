 while(d<=limit&&count++<18){const y=d.getFullYear(),m=d.getMonth(),first=new Date(y,m,1).getDay(),length=new Date(y,m+1,0).getDate();let cells=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(x=>'<div class="calendar-cell calendar-head">'+x+'</div>').join('');for(let i=0;i<first;i++)cells+='<div></div>';for(let day=1;day<=length;day++){const date=y+'-'+String(m+1).padStart(2,'0')+'-'+String(day).padStart(2,'0');cells+='<div class="calendar-cell '+(date>=start&&date<=(end||start)?(date<today?'calendar-past ':'calendar-travel '):'')+(date===today?'calendar-today':'')+'">'+day+'</div>';}months.push('<div class="calendar-title">'+d.toLocaleDateString('en-GB',{month:'long',year:'numeric'})+'</div><div class="calendar-grid">'+cells+'</div>');d=new Date(y,m+1,1)}
 cal.innerHTML='<h3>🗓️ Travel calendar</h3>'+months.join('<div style="height:16px"></div>');
}
