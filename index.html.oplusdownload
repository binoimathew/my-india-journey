function accommodationAlreadyCovered(item){
 if(!item||!item.date)return false;
 const b=item.booking||{};
 const isAccommodation=item.kind==='planned'?/hotel|stay|accommodat|room|lodg|check-in/i.test(String(b[1]||'')):b.type==='Accommodation';
 if(!isAccommodation)return false;
 const text=String(item.kind==='planned'?b[1]||'':[b.name,b.details?.hotel,b.details?.place].filter(Boolean).join(' ')).toLowerCase();
 const candidates=accommodationCoveringDate(item.date).filter(stay=>stay.id!==b.id&&['booked','confirmed'].includes(String(stay.status||'').toLowerCase()));
 return candidates.some(stay=>{
  const place=String(stay.details?.place||'').trim().toLowerCase();
  const hotel=String(stay.details?.hotel||stay.name||'').trim().toLowerCase();
  const norm=x=>x.replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim();
  const t=norm(text);
  return (place&&t.includes(norm(place)))||(hotel&&norm(hotel).length>=5&&t.includes(norm(hotel)));
 });
}
