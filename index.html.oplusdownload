 const startDate=new Date(start+'T00:00:00'),endDate=new Date((end||start)+'T23:59:59');const fmt=d=>d.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
 if(now<startDate){const delta=startDate-now,days=Math.floor(delta/86400000),hours=Math.floor(delta%86400000/3600000),mins=Math.floor(delta%3600000/60000);hero.innerHTML='<div class="tiny" style="color:#d4e9ef">YOUR JOURNEY BEGINS IN</div><div class="hero-count">'+days+'d '+hours+'h '+mins+'m</div><div>Departure: '+fmt(startDate)+'</div>';}
 else if(now<=endDate){const num=Math.floor((new Date(today+'T00:00:00')-startDate)/86400000)+1;hero.innerHTML='<div class="hero-date">'+fmt(now)+'</div><div class="hero-day">Day '+Math.max(1,num)+' of your journey</div>';}
