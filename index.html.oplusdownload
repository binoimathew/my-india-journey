function paise(n){return Math.round((Number(n)||0)*100)}
function renderSettlement(){
 const group=groupMembers(),n=group.length;
 const shared=data.expenses,total=shared.reduce((sum,e)=>sum+paise(e.amount),0);
 const balances=Object.fromEntries(group.map(m=>[m.id,0]));
 const per=Math.floor(total/n),remainder=total%n;
 group.forEach((m,i)=>balances[m.id]-=per+(i<remainder?1:0));
 shared.forEach(e=>{const id=e.paidBy||'leader';if(id in balances)balances[id]+=paise(e.amount)});
 data.contributions.forEach(c=>{const amount=paise(c.amount);if(c.from in balances)balances[c.from]+=amount;if(c.to in balances)balances[c.to]-=amount});
 const totalPaid=Object.fromEntries(group.map(m=>[m.id,shared.filter(e=>(e.paidBy||'leader')===m.id).reduce((sum,e)=>sum+paise(e.amount),0)]));
 const given=Object.fromEntries(group.map(m=>[m.id,data.contributions.filter(c=>c.from===m.id).reduce((sum,c)=>sum+paise(c.amount),0)]));
 const received=Object.fromEntries(group.map(m=>[m.id,data.contributions.filter(c=>c.to===m.id).reduce((sum,c)=>sum+paise(c.amount),0)]));
 const rows=group.map((m,i)=>{const due=balances[m.id];const contributed=totalPaid[m.id]+given[m.id];return `<tr><td>${i+1}. ${escapeHTML(m.name)}</td><td><strong>${money(contributed/100)}</strong><div class="tiny">Expenses: ${money(totalPaid[m.id]/100)}<br>Given: ${money(given[m.id]/100)}${received[m.id]?`<br>Received: ${money(received[m.id]/100)}`:''}</div></td><td>${money((per+(i<remainder?1:0))/100)}</td><td>${due<0?`<strong>Pay ${money(-due/100)}</strong>`:due>0?`<strong>Receive ${money(due/100)}</strong>`:'Settled'}</td></tr>`}).join('');
 // Positive balance = money owed to this person, negative = money this person owes.
 const debtors=group.map(m=>({id:m.id,amount:Math.max(0,-balances[m.id])})).filter(x=>x.amount>0);
 const creditors=group.map(m=>({id:m.id,amount:Math.max(0,balances[m.id])})).filter(x=>x.amount>0);
 const transfers=[];let i=0,j=0;
 while(i<debtors.length&&j<creditors.length){const amt=Math.min(debtors[i].amount,creditors[j].amount);if(amt>0)transfers.push(`${escapeHTML(memberName(debtors[i].id))} → ${escapeHTML(memberName(creditors[j].id))}: <strong>${money(amt/100)}</strong>`);debtors[i].amount-=amt;creditors[j].amount-=amt;if(!debtors[i].amount)i++;if(!creditors[j].amount)j++}
 el('settlement').innerHTML=`<strong>Pooled expenses: ${money(total/100)} · ${n} member(s)</strong><div class="tiny">Each person's equal share is approximately ${money(total/100/n)}. All recorded expenses are included in the common pool, regardless of their previous pooled setting.</div><div class="ledger"><table><thead><tr><th>Member</th><th>Paid for group (expenses + transfers given)</th><th>Share</th><th>Balance</th></tr></thead><tbody>${rows}</tbody></table></div><p class="tiny">Paid for group includes direct expenses plus money given to other members. Transfers received are shown separately and deducted when calculating the balance. Money transferred between members is not counted as a new group expense. “Receive” means refund due; “Pay” means amount owed.</p><h3>Suggested final payments</h3>${transfers.length?transfers.map(t=>`<div class="checkrow">${t}</div>`).join(''):'<div class="tiny">Everyone is settled.</div>'}`;
 el('contributionList').innerHTML=data.contributions.length?data.contributions.slice().reverse().map(c=>`<div class="expense"><div><strong>${money(c.amount)}</strong> · ${escapeHTML(memberName(c.from))} → ${escapeHTML(memberName(c.to))}<div class="muted">${escapeHTML(c.date)} ${escapeHTML(c.time||'')} · ${escapeHTML(c.note||'Contribution')}</div></div><button type="button" data-delete-contribution="${escapeHTML(c.id)}" aria-label="Delete contribution">✕</button></div>`).join(''):'<p class="tiny">No contributions recorded.</p>';
