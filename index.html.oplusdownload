n data-tab="itinerary">📅<br>Days</button><button data-tab="places">📍<br>Places</button><button data-tab="journeymap">🗺️<br>Map</button><button data-tab="expenses">💰<br>Expenses</button><button data-tab="bookings">🎟️<br>Bookings</button></nav><script>
