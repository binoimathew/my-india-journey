<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>JourneyMate</title><meta name="theme-color" content="#15345b"><meta name="description" content="Offline itinerary, visits, bookings and shared travel expenses"><link rel="manifest" href="./manifest.webmanifest"><link rel="icon" href="./icon-192.png"><link rel="apple-touch-icon" href="./icon-192.png"><style>:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#16253b;background:#f3f6fa}*{box-sizing:border-box}body{margin:0}header{background:linear-gradient(120deg,#15345b,#176b80);color:white;padding:22px 18px 18px}header h1{margin:0;font-size:23px}header p{margin:6px 0 0;font-size:13px;opacity:.9}main{max-width:700px;margin:auto;padding:14px 14px 88px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:14px}.stat,.panel,.day{background:white;border-radius:14px;padding:14px;box-shadow:0 2px 12px #18304c0c}.stat strong{display:block;font-size:23px;color:#145b73}.stat small{color:#627188}nav{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:center;background:white;border-top:1px solid #dbe3ec;z-index:10}nav button{flex:1;min-width:0;border:0;background:white;padding:12px 2px;color:#56677d;font-size:12px}nav button.active{color:#08748a;font-weight:800;background:#e8f7f9}.page{display:none}.page.active{display:block}h2{font-size:18px;margin:16px 0 12px}.day{margin:9px 0}.day h3{margin:0 0 5px;font-size:16px}.sub{color:#627188;font-size:13px}.pill{display:inline-block;border-radius:40px;background:#e9f2f6;padding:4px 9px;font-size:11px;color:#15586c;margin:5px 3px 0 0}.booked{background:#e0f6e8;color:#176b40}.pending{background:#fff3d9;color:#946200}.day ul{margin:10px 0 0;padding-left:20px;font-size:14px;line-height:1.7}label{display:block;font-size:13px;font-weight:650;margin:10px 0 5px}input,select,textarea{width:100%;border:1px solid #cbd7e3;border-radius:9px;padding:11px;font:inherit;background:white;color:#16253b}button.action{background:#146d83;border:0;border-radius:9px;padding:11px 15px;color:white;font-weight:700;margin-top:12px}button.secondary{background:#e9f1f6;color:#174f65}.expense{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e5ebf0;padding:10px 0;gap:10px}.expense button{background:#fbe8e8;color:#9b2929;border:0;border-radius:8px;padding:7px}.checkrow{display:flex;gap:10px;align-items:flex-start;border-bottom:1px solid #e8eef2;padding:11px 0;font-size:14px}.checkrow input{width:auto;margin-top:3px;accent-color:#08748a}.muted{color:#67778a;font-size:12px}.empty{padding:20px;color:#728094;text-align:center}footer{font-size:11px;color:#738198;text-align:center;padding:20px}.flex{display:flex;gap:10px}.flex>*{flex:1}.progress{height:9px;background:#dfe9ef;border-radius:20px;overflow:hidden}.progress div{height:100%;background:#1b8793;transition:width .2s}summary{cursor:pointer;font-weight:650}.warning{background:#fff4dc;padding:12px;border-radius:10px;font-size:12px;color:#79551a}.mealgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.mealgrid label{margin:0}.dayplace{display:flex;gap:8px;align-items:center;padding:5px 0;font-size:13px}.dayplace input{width:auto}.dayextras{max-width:260px}.tiny{font-size:12px;color:#617487}.ledger{overflow-x:auto}.ledger table{width:100%;border-collapse:collapse;font-size:12px;white-space:nowrap}.ledger th,.ledger td{padding:8px;border-bottom:1px solid #e5ebf0;text-align:left}.badgepool{background:#eaf1ff;color:#244f91;padding:3px 6px;border-radius:6px}.alarm{border-left:3px solid #ef9c33;padding-left:10px;margin-top:12px}input[type=checkbox]{width:auto}.inlinecheck{display:flex;gap:9px;align-items:center}.inlinecheck input{flex:0 0 auto} .totals{padding:10px;background:#edf6f7;border-radius:9px;margin-top:12px}.mapframe{width:100%;height:320px;border:0;border-radius:12px;background:#eaf1f5}.gpsitem{padding:12px 0;border-bottom:1px solid #e5ebf0}.gpsitem button{margin-right:8px}.gpsstatus{font-size:12px;color:#576b7c}.time-highlight{display:inline-block;background:#dceefa;color:#074c75;border-radius:8px;padding:5px 9px;font-weight:800;font-size:14px;margin:3px 5px 3px 0}.pending-warning{color:#b42318;font-weight:800}.done-item{opacity:.78;background:#f0f5f1}.taskcheck{display:inline-flex;align-items:center;gap:7px;font-size:12px;margin:5px 0}.taskcheck input{width:auto} .header-journey-status{font-size:16px;font-weight:800;color:#ffe29a;margin-top:9px}.trip-hero{background:linear-gradient(120deg,#103c65,#176e80);color:white;border-radius:15px;padding:17px;margin-bottom:12px}.hero-count{font-size:26px;font-weight:850;color:#ffe29a}.hero-date{font-size:22px;font-weight:750}.hero-day{font-size:18px;color:#bdeff1;margin-top:3px}.travel-quote{font-style:italic;text-align:center;color:#496077;margin:12px 8px 18px;font-size:13px}.travel-quote span{display:block;font-style:normal;margin-top:5px}.calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.calendar-cell{text-align:center;border-radius:8px;padding:8px 1px;font-size:12px}.calendar-head{font-weight:800;color:#64748b}.calendar-travel{background:#bcebf1;color:#0b5369;font-weight:800}.calendar-today{outline:2px solid #d28b2c}.calendar-past{background:transparent;color:#9ba7b5;font-weight:400}.calendar-title{font-weight:800;margin:0 0 9px}.date-weekday{color:#087e9a;font-weight:850;margin-right:4px}.booking-departure-inline{grid-column:1/-1}.booking-departure-inline input{width:100%} .booking-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;margin-top:12px}.booking-fields label{margin:0}.booking-fields input,.booking-fields select{margin-top:5px}.booking-fields .wide{grid-column:1/-1}@media(max-width:440px){.booking-fields{grid-template-columns:1fr}} .unreserved-highlight{display:inline-block;background:#dbeafe;color:#174ea6;border:1px solid #93c5fd;padding:4px 9px;border-radius:8px;font-weight:700;margin:5px 0}.unreserved-hidden{display:none} .booking-summary-date{font-weight:850;color:#111827;font-size:16px}.booking-summary-mode{font-weight:800;color:#075eaa;font-size:15px}.booking-summary-description{font-size:13px;font-weight:400;color:#52657d;line-height:1.35}.booking-summary-details{min-width:0;flex:1}.booking-summary-status{flex:0 0 auto;white-space:nowrap} </style><!-- JourneyMate v2.14.2: GPX track export fix -->
</head><body><header><h1>🧭 JourneyMate</h1><p>Plan trips · Track places · Split expenses</p><div id="headerJourneyStatus" class="header-journey-status">Set your travel dates to start the countdown.</div></header><main><section id="dashboard" class="page active"><div id="tripHero" class="trip-hero"></div><div id="tripCalendar" class="panel trip-calendar"></div><div class="travel-quote" style="display:block!important">“Travel makes one modest. You see what a tiny place you occupy in the world.” <span>— Gustave Flaubert</span></div><div class="stats"><div class="stat"><small>Places visited</small><strong id="placesStat">0 / 0</strong></div><div class="stat"><small>Expenses logged</small><strong id="expenseStat">₹0</strong></div><div class="stat"><small>Trip budget</small><strong id="budgetStat">₹0</strong></div><div class="stat"><small>Budget remaining</small><strong id="remainingStat">₹0</strong></div></div><div class="panel"><label for="budget">Set your total budget (₹)</label><input id="budget" type="number" min="0" step="100"><div id="budgetFunding" class="totals"><strong>Additional trip funding</strong><p class="tiny">Record funds added after setting the initial budget. The original budget stays unchanged.</p><div id="fundingSummary"></div><form id="addFundsForm"><label for="fundDate">Date added</label><input id="fundDate" type="date" required><label for="fundAmount">Additional amount (₹)</label><input id="fundAmount" type="number" min="0.01" step="0.01" required><label for="fundNote">Reason (optional)</label><input id="fundNote" placeholder="e.g. Additional transport costs"><button class="action" type="submit">+ Add funds</button></form><div id="fundingHistory"></div></div><div class="panel" id="projectManager" style="border:2px solid #0c7890;margin:14px 0"><h2>🗂️ Travel projects</h2><label for="projectSelector">Active project</label><select id="projectSelector"></select><div id="projectIdentity" class="tiny"></div><button class="action secondary" type="button" id="projectNew">+ New independent project</button><button class="action secondary" type="button" id="projectSaveFile">💾 Save / update project JSON</button><button class="action secondary" type="button" id="projectShareFile">📤 Save JSON via Android share / Files</button><p id="projectBackupStatus" class="tiny" role="status" aria-live="polite"></p><p class="tiny">Each project has its own local data and stable backup filename. Updating the same file requires browser permission; otherwise a download is created.</p></div><h2>🌍 Your trip</h2><label>Trip name</label><input id="tripName" placeholder="e.g. Weekend in Goa"><div class="flex"><div><label>Start date</label><input type="date" id="tripStart"></div><div><label>End date</label><input type="date" id="tripEnd"></div></div><button class="action secondary" id="saveTrip">Save trip details</button><button class="action secondary" id="newTrip">Start a new blank trip</button><p class="tiny">Starting a new trip replaces the current trip on this device. Export a backup first.</p><h2>Travel type</h2><label for="travelMode">Travelling solo or with a group?</label><select id="travelMode"><option value="solo">Solo journey</option><option value="group">Group journey</option></select><p id="travelModeHelp" class="tiny"></p><label id="leaderLabel">Traveller name</label><input id="leader" placeholder="Name of team leader"><div id="groupHomeControls"><label>Team members (leader is always number 1)</label><div id="memberRoster"></div><label>Add team member</label><div class="flex"><input id="newMemberName" placeholder="Friend's name"><button type="button" class="action secondary" id="addMember">+ Add member</button></div><p class="tiny">The team leader is Member 1. Add each friend by name. All active members share pooled expenses equally.</p><label>Number of members (automatically calculated)</label><input id="members" type="number" min="1" readonly></div><h2>Journey progress</h2><div class="progress"><div id="bar" style="width:0%"></div></div><p id="progressText" class="muted"></p><div class="warning">📴 Works without internet once saved on your phone. Entries are stored in this browser on this device; export a backup regularly. No automatic GPS tracking or notifications.</div></div><h2>Booking status at a glance</h2><div id="homeBookingOverview" class="panel"></div><h2>Next booking tasks</h2><div id="pending"></div><div class="panel" style="margin-top:14px"><strong>📲 App version and updates</strong><p class="muted">Version 2.14.1 · Updates are available after publishing this app at a permanent HTTPS address. Your records stay on this device.</p><button class="action secondary" id="checkUpdates" type="button">↻ Check for updates</button><p id="updateStatus" class="muted" role="status"></p></div><button class="action secondary" id="exportBtn">⬇ Export backup (JSON)</button><label for="restore">Restore backup (JSON)</label><input id="restore" type="file" accept="application/json"><button class="action secondary" id="csvBtn">⬇ Export expenses (CSV)</button><div class="panel" style="margin-top:18px;border:1px solid #d97777"><h3>🗑️ Reset all app data</h3><p class="muted">Erase all trips, itineraries, expenses, team members, contributions, bookings, GPS stops and settings stored in JourneyMate on this device. The app will restart with a completely blank trip. This cannot be undone without a backup.</p><button class="action secondary" id="resetAllData" type="button" style="border-color:#b42318;color:#b42318">Reset all data and start fresh</button></div></section><section id="itinerary" class="page"><h2>📅 Daily itinerary</h2><div class="panel"><h3 id="dayFormHeading">➕ Add itinerary event</h3><form id="dayForm"><input type="hidden" id="dayEditIndex" value=""><label>Date</label><input type="date" id="dayDate" required><label>Time (optional)</label><input type="time" id="dayTime"><label>Destination / day title</label><input id="dayTitle" required><label>Schedule / itinerary details</label><textarea id="dayDetails" rows="3" placeholder="Train times, activities, landmarks"></textarea><label>Overnight stay</label><input id="dayStay" placeholder="Hotel, city or overnight train"><label>Places to visit (comma separated)</label><input id="dayPlaces" placeholder="Fort, museum, market"><button class="action" id="daySubmit" type="submit">Add event</button><button class="action secondary" id="dayCancelEdit" type="button" hidden>Cancel editing</button></form><details><summary>🤖 ChatGPT Import — fill trip pages automatically</summary><p class="tiny">Use ChatGPT to create a JourneyMate import JSON file from your itinerary. Paste the JSON here or upload the .json file. Preview before importing. This does not connect JourneyMate to ChatGPT or send your trip to an AI service.</p><button class="action secondary" id="copyAIPrompt" type="button">📋 Copy ChatGPT conversion prompt</button><p class="tiny">Paste the copied prompt and your itinerary into ChatGPT. Copy its JSON response or save it as a .json file.</p><label for="aiImportFile">Upload ChatGPT JSON file</label><input type="file" id="aiImportFile" accept=".json,application/json"><label for="aiImportText">Or paste ChatGPT JSON</label><textarea id="aiImportText" rows="6" placeholder='{ "trip": { "name": "...", "start": "YYYY-MM-DD", "end": "YYYY-MM-DD" }, "days": [ ... ] }'></textarea><button class="action secondary" id="aiPreviewBtn" type="button">🔎 Read & preview all pages</button><p id="aiImportStatus" class="tiny" role="status" aria-live="polite" style="font-weight:700;padding:9px;background:#edf6f7;border-radius:8px">Choose a JSON file or paste JSON, then tap Read & preview all pages.</p><div id="aiPreviewPanel" hidden><h3>Import preview</h3><div id="aiPreviewSummary"></div><label><input type="checkbox" id="aiImportBookings" checked> Include proposed booking reminders (not confirmed tickets)</label><label><input type="checkbox" id="aiImportBudget" checked> Import trip budget when supplied</label><button class="action" id="aiConfirmBtn" type="button">Import into JourneyMate</button><button class="action secondary" id="aiCancelBtn" type="button">Cancel</button></div></details><details open><summary>Smart itinerary import — paste or upload</summary>
<p class="tiny">Paste an AI-written itinerary or upload a TXT, Markdown, Word (.docx) or text-based PDF file. JourneyMate detects dated days, destinations, activities, overnight stays and some named stops. <strong>Preview and correct everything before importing.</strong> Word and PDF reading requires internet for document libraries; scanned PDFs/images are not supported. This is an on-device rules-based parser, not an AI service.</p>
<label for="smartFile">Upload itinerary file</label><input type="file" id="smartFile" accept=".txt,.md,.csv,.docx,.pdf,text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document">
<label for="importText">Or paste itinerary text</label><textarea id="importText" rows="8" placeholder="Day 1 – 16 November 2026: Ernakulam to Surat&#10;12:50 PM train departure from Ernakulam Junction&#10;Overnight: Train"></textarea>
<button class="action secondary" id="parseSmart" type="button">🔎 Read & preview itinerary</button><p class="tiny" id="importStatus" role="status"></p>
<div id="smartPreview" hidden><h3>Review detected days</h3><p class="tiny">Edit dates, destinations, activities, stays and places. Places are added as unchecked places-to-visit, not marked visited. Unrecognized details are retained in the activities field where possible.</p><div id="smartPreviewRows"></div><button class="action" id="confirmSmart" type="button">Import reviewed itinerary</button><button class="action secondary" id="cancelSmart" type="button">Cancel preview</button></div>
</details></div><div id="days"></div><h2>✅ Completed travel events — actual date and time</h2><div id="completedDays"></div></section><section id="places" class="page"><h2>📍 Places covered</h2><p class="muted">Tick places as you visit them.</p><div id="placeList" class="panel"></div><h3>✅ Completed places</h3><div id="completedPlaces" class="panel"></div></section><section id="journeymap" class="page"><h2>🗺️ Journey Map & GPS Stops</h2><div class="panel"><p class="muted">At a station or attraction, tap Mark current location. JourneyMate saves your GPS coordinates and the current date and time. Location permission and a GPS signal are required.</p><button type="button" class="action" id="markGPS">📍 Mark current location</button><p id="gpsStatus" class="gpsstatus" role="status"></p><label>Place name (fallback only)</label><input id="gpsName" placeholder="Only if automatic place lookup fails"><label>Three-word note (optional)</label><input id="gpsNote" maxlength="70" placeholder="Train halted here"><p class="tiny">Place names are looked up automatically from GPS coordinates. Enter a name only if the lookup fails, or rename a saved stop.</p><p class="warning">GPS works only after granting location permission. Position accuracy may be reduced inside trains or station buildings. Automatic place-name lookup and map tiles require internet, but saved coordinates remain available offline. This feature records individual stops, not continuous background tracking.</p></div><h2>▶ Travel Route Replay</h2><div class="panel"><p class="muted">Replay saved GPS stops in chronological order. The connecting lines are straight-line visualisations, not actual roads or train tracks. No continuous location tracking is performed.</p><svg id="routeReplayMap" viewBox="0 0 600 350" role="img" aria-label="Animated travel route from saved GPS stops" style="width:100%;height:auto;background:#edf5f8;border-radius:12px;border:1px solid #d4e1eb"></svg><p id="routeReplayStatus" class="gpsstatus" role="status">Save at least two GPS stops to replay your journey.</p><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="action" id="routePlay" type="button">▶ Play replay</button><button class="action secondary" id="routePause" type="button">⏸ Pause</button><button class="action secondary" id="routeReset" type="button">↺ Restart</button></div><label for="routeSpeed">Replay speed</label><select id="routeSpeed"><option value="2500">Slow</option><option value="1200" selected>Normal</option><option value="450">Fast</option></select><p class="tiny">Stops are taken from your saved GPS log; the replay also works offline.</p></div><h2>Saved stops</h2><div id="gpsStops" class="panel"></div><h2>Map</h2><div class="panel"><div id="gpsMapHelp" class="muted">Mark a location to view it on the map.</div><iframe id="gpsMap" class="mapframe" title="Map of saved GPS stops" loading="lazy" hidden></iframe><p class="tiny">The map displays your saved points; connecting them in order does not represent the actual rail or road route.</p><button class="action secondary" id="gpsCSV" type="button">⬇ Export GPS stops (CSV)</button><button class="action secondary" id="gpsGPX" type="button">⬇ Export GPS stops (GPX)</button></div></section><section id="expenses" class="page"><h2>💰 Expense tracker</h2><div class="panel"><form id="expenseForm"><div id="groupPayerControl"><label>Paid by (team leader first)</label><select id="expensePayer"></select></div><label>Date</label><input id="expenseDate" type="date" required><label>Expense time (automatically set to now; edit only for earlier expenses)</label><input id="expenseTime" type="time" required><label>Quick food and drink entries (₹) — enter any number of columns</label><div class="mealgrid" id="mealGrid"></div><button type="button" class="action secondary" id="addMeals">+ Save food/drink entries</button><h2>Other expenses</h2><label>Category</label><select id="category"><option>Train</option><option>Flight</option><option>Accommodation</option><option>Shared car</option><option>Common tickets</option><option>Food</option><option>Taxi/Auto</option><option>Bus</option><option>Entry/Permit</option><option>Shopping</option><option>Other</option></select><label>Amount (₹)</label><input id="amount" type="number" min="1" step="0.01" required><label>Note / location</label><input id="note" placeholder="e.g. Taxi Lalitpur to Pranpur"><p class="tiny" id="expenseSharingHint">Expenses are recorded for this journey.</p><input id="pooled" type="checkbox" checked hidden><button class="action" type="submit">+ Add expense</button></form></div><div id="groupExpenseControls"><h2>💸 Contributions to team leader</h2><div class="panel"><p class="tiny">Record money handed to the leader for group spending. This is a transfer, not an expense, and must not be added to travel costs.</p><form id="contributionForm"><label>Received from</label><select id="contributionFrom" required></select><label>Received by</label><select id="contributionTo" required></select><label>Amount (₹)</label><input id="contributionAmount" type="number" min="0.01" step="0.01" required><label>Date</label><input id="contributionDate" type="date" required><label>Time</label><input id="contributionTime" type="time" required><label>Note (optional)</label><input id="contributionNote" placeholder="Cash / UPI / advance"><button type="submit" class="action">+ Record contribution</button></form><div id="contributionList"></div></div><h2>Group settlement</h2><div id="settlement" class="totals"></div></div><h2>Expense totals — always up to date</h2><div class="panel" aria-live="polite"><div class="stats" style="margin-bottom:0"><div class="stat"><small>Total spent so far</small><strong id="expenseGrandTotal">₹0</strong></div><div class="stat"><small>Spent today</small><strong id="expenseTodayTotal">₹0</strong></div><div class="stat"><small>Remaining budget</small><strong id="expenseRemainingBudget">₹0</strong></div><div class="stat"><small>Number of expenses</small><strong id="expenseEntryCount">0</strong></div></div><p class="tiny">Totals include every recorded expense. Booking costs are counted only when added to the expense ledger. Group contributions are not expenses.</p></div><section class="panel" id="preTourSection" style="margin-top:22px;border:2px solid #9a83ca;background:#fbf9ff">
<h2>🧳 Pre-tour purchases — separate ledger</h2>
<p class="tiny">Clothing, bags, equipment and other purchases made in preparation for travel. These costs are personal purchases and are <strong>never included</strong> in the tour budget, tour expenses, group pool or settlements.</p>
<form id="preTourForm">
<div class="flex"><div><label for="preTourDate">Purchase date</label><input id="preTourDate" type="date" required></div><div><label for="preTourTime">Time (optional)</label><input id="preTourTime" type="time"></div></div>
<label for="preTourCategory">Category</label><select id="preTourCategory"><option>Clothing</option><option>Bags / luggage</option><option>Camera / electronics</option><option>Footwear</option><option>Travel accessories</option><option>Toiletries</option><option>Other preparation</option></select>
<label for="preTourItem">Item purchased</label><input id="preTourItem" required placeholder="e.g. Lightweight jacket">
<label for="preTourAmount">Purchase price (₹)</label><input id="preTourAmount" type="number" min="0.01" step="0.01" required>
<label for="preTourNote">Shop / remarks (optional)</label><input id="preTourNote" placeholder="Store, size, notes">
<button class="action" type="submit">+ Add pre-tour purchase</button>
</form>
<div class="totals" style="background:#f0eaf9"><strong>Pre-tour purchases total: <span id="preTourTotal">₹0</span></strong><div class="tiny"><span id="preTourCount">0</span> purchases · Excluded from trip calculations</div></div>
<div id="preTourList"></div>
